{
  "name": "so-tu-hoc-vue",
  "private": true,
  "version": "8.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "vitest run --configLoader runner tests/unit",
    "test:watch": "vitest",
    "test:static": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "package:edge": "node scripts/package-edge-functions.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.0.0",
    "@vueuse/core": "^13.0.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
